---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import EventRow from '../components/EventRow.astro';
import PostRow from '../components/PostRow.astro';
import AnnouncementRow from '../components/AnnouncementRow.astro';
import { url } from '../site';
import { getClub, getPage, getEvents, getPosts, getAnnouncements } from '../content';

const club = await getClub();
const home = await getPage('home');
const Intro = home?.body?.trim() ? (await render(home)).Content : undefined;
const { upcoming } = await getEvents();
const posts = await getPosts();
const announcements = await getAnnouncements();
---

<Base>
  <div class="wrap">
    <section class="hero">
      <h1>{home?.data.title ?? club.name}</h1>
      {Intro && <div class="prose intro"><Intro /></div>}
      <div class="actions">
        <a class="button" href={url('/join/')}>Join</a>
        <a href={url('/events/')}>Events</a>
      </div>
    </section>

    <section class="section" aria-labelledby="upcoming">
      <div class="section-head">
        <h2 id="upcoming">Upcoming events</h2>
        <a href={url('/events/')}>All events</a>
      </div>
      {
        upcoming.length > 0 ? (
          <ul class="rows">
            {upcoming.slice(0, 3).map((event) => <EventRow event={event} />)}
          </ul>
        ) : (
          <p class="empty">No upcoming events.</p>
        )
      }
    </section>

    {
      announcements.length > 0 && (
        <section class="section" aria-labelledby="announcements">
          <div class="section-head">
            <h2 id="announcements">Announcements</h2>
            <a href={url('/announcements/')}>All announcements</a>
          </div>
          <ul class="rows">
            {announcements.slice(0, 3).map((announcement) => (
              <AnnouncementRow announcement={announcement} />
            ))}
          </ul>
        </section>
      )
    }

    {
      posts.length > 0 && (
        <section class="section" aria-labelledby="blog">
          <div class="section-head">
            <h2 id="blog">Blog</h2>
            <a href={url('/blog/')}>All posts</a>
          </div>
          <ul class="rows">
            {posts.slice(0, 3).map((post) => <PostRow post={post} />)}
          </ul>
        </section>
      )
    }
  </div>
</Base>

<style>
  .hero {
    padding-block: clamp(3rem, 9vw, 6.5rem) clamp(1rem, 3vw, 2rem);
  }

  .hero h1 {
    font-size: clamp(2.5rem, 7.2vw, 5.25rem);
    letter-spacing: -0.035em;
    line-height: 1.05;
    max-width: 14ch;
  }

  .intro {
    margin-top: 2.25rem;
    font-size: clamp(1.125rem, 2vw, 1.3125rem);
    line-height: 1.5;
  }
</style>
