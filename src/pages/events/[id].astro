---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { url, formatDay, formatTime, isoDay } from '../../site';
import { getEvents, titleOf, eventLinks } from '../../content';

export async function getStaticPaths() {
  const { upcoming, past } = await getEvents();
  return [...upcoming, ...past].map((event) => ({ params: { id: event.id }, props: { event } }));
}

const { event } = Astro.props;
const { kind, date, location, summary, speaker } = event.data;
const title = titleOf(event);
const time = formatTime(date);
const links = eventLinks(event);
const { Content } = await render(event);
---

<Base title={title} description={summary}>
  <article class="wrap">
    <header class="page-head">
      {kind && <p class="label">{kind}</p>}
      <h1>{title}</h1>
      {summary && <p class="lede">{summary}</p>}
    </header>

    <dl class="facts">
      <dt class="label">When</dt>
      <dd><time datetime={isoDay(date)}>{formatDay(date)}{time && `, ${time}`}</time></dd>
      {location && <dt class="label">Where</dt>}
      {location && <dd>{location}</dd>}
      {speaker && <dt class="label">Speaker</dt>}
      {speaker && <dd>{speaker}</dd>}
      {links.length > 0 && <dt class="label">Materials</dt>}
      {
        links.length > 0 && (
          <dd class="fact-links">
            {links.map((link) => <a href={url(link.href)}>{link.label}</a>)}
          </dd>
        )
      }
    </dl>

    <div class="prose body"><Content /></div>

    <a class="back" href={url('/events/')}>All events</a>
  </article>
</Base>

<style>
  .page-head .label {
    margin-bottom: 1rem;
  }

  .fact-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
  }

  .body {
    margin-top: 2.5rem;
  }
</style>
