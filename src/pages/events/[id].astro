---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { url, formatDay, formatTime, isoDay } from '../../site';

export async function getStaticPaths() {
  const events = await getCollection('events');
  return events.map((event) => ({ params: { id: event.id }, props: { event } }));
}

const { event } = Astro.props;
const { title, kind, date, location, summary, speaker, slides, materials } = event.data;
const { Content } = await render(event);
---

<Base title={title} description={summary}>
  <article class="wrap">
    <header class="page-head">
      <p class="label">{kind}</p>
      <h1>{title}</h1>
      <p class="lede">{summary}</p>
    </header>

    <dl class="facts">
      <dt class="label">When</dt>
      <dd><time datetime={isoDay(date)}>{formatDay(date)}, {formatTime(date)}</time></dd>
      <dt class="label">Where</dt>
      <dd>{location}</dd>
      {speaker && <dt class="label">Speaker</dt>}
      {speaker && <dd>{speaker}</dd>}
      {(slides || materials.length > 0) && <dt class="label">Materials</dt>}
      {
        (slides || materials.length > 0) && (
          <dd class="fact-links">
            {slides && <a href={url(slides)}>Slides</a>}
            {materials.map((item) => <a href={url(item.href)}>{item.label}</a>)}
          </dd>
        )
      }
    </dl>

    <div class="prose body"><Content /></div>

    <a class="back" href={url('/events/')}>All events</a>
  </article>
</Base>

<style>
  .page-head .label {
    margin-bottom: 1rem;
  }

  .fact-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
  }

  .body {
    margin-top: 2.5rem;
  }
</style>
