---
import Base from '../../layouts/Base.astro';
import PageIntro from '../../components/PageIntro.astro';
import EventRow from '../../components/EventRow.astro';
import { url } from '../../site';
import { getEvents } from '../../content';

const { upcoming, past } = await getEvents();
---

<Base title="Events">
  <div class="wrap">
    <PageIntro page="events" fallbackTitle="Events" />

    <section aria-labelledby="upcoming">
      <div class="section-head">
        <h2 id="upcoming">Upcoming</h2>
      </div>
      <ul class="rows" data-upcoming>{upcoming.map((event) => <EventRow event={event} />)}</ul>
      <p class="empty" data-upcoming-empty hidden={upcoming.length > 0}>No upcoming events.</p>
    </section>

    <section class="section" aria-labelledby="past" hidden={past.length === 0}>
      <div class="section-head">
        <h2 id="past">Past</h2>
        <a href={url('/materials/')}>Materials</a>
      </div>
      <ul class="rows" data-past>{past.map((event) => <EventRow event={event} />)}</ul>
    </section>
  </div>
</Base>
