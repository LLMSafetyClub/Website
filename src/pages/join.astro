---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import { getClub } from '../content';

const club = await getClub();
const hasFacts = club.meeting || club.email || club.channels.length > 0;
---

<Base title="Join">
  <div class="wrap">
    <PageIntro page="join" fallbackTitle="Join" />

    {
      hasFacts && (
        <dl class="facts">
          {club.meeting && <dt class="label">Meetings</dt>}
          {club.meeting && <dd>{club.meeting}</dd>}
          {club.email && <dt class="label">Email</dt>}
          {club.email && <dd><a href={`mailto:${club.email}`}>{club.email}</a></dd>}
          {
            club.channels.map((channel) => (
              <>
                <dt class="label">{channel.label}</dt>
                <dd><a href={channel.href}>{channel.href.replace(/^https?:\/\//, '')}</a></dd>
              </>
            ))
          }
        </dl>
      )
    }
  </div>
</Base>
