---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import { url, formatDay, isoDay } from '../site';
import { getEvents, titleOf, eventLinks } from '../content';

const { upcoming, past } = await getEvents();
const withMaterials = [...upcoming.reverse(), ...past]
  .map((event) => ({ event, links: eventLinks(event) }))
  .filter(({ links }) => links.length > 0);
---

<Base title="Materials">
  <div class="wrap">
    <PageIntro page="materials" fallbackTitle="Materials" />

    <hr class="rule" />
    {
      withMaterials.length > 0 ? (
        <ul class="rows">
          {withMaterials.map(({ event, links }) => (
            <li class="row">
              <div class="row-when">
                <time class="label" datetime={isoDay(event.data.date)}>{formatDay(event.data.date)}</time>
                {event.data.kind && <span class="label">{event.data.kind}</span>}
              </div>
              <div class="row-body">
                <h3><a href={url(`/events/${event.id}/`)}>{titleOf(event)}</a></h3>
                <div class="row-links">
                  {links.map((link) => <a href={url(link.href)}>{link.label}</a>)}
                </div>
              </div>
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty">No materials yet.</p>
      )
    }
  </div>
</Base>
