---
import Base from '../layouts/Base.astro';
import { url, formatDay, isoDay } from '../site';
import { getEvents } from '../content';

const { upcoming, past } = await getEvents();
const withMaterials = [...upcoming.reverse(), ...past].filter(
  (event) => event.data.slides || event.data.materials.length > 0,
);
---

<Base title="Materials" description="Slides, notebooks, and recordings from past club events.">
  <div class="wrap">
    <header class="page-head">
      <h1>Materials</h1>
      <p class="lede">
        Slides, notebooks, and recordings from our events, newest first. Reuse them freely, and
        tell us if you find a mistake.
      </p>
    </header>

    <hr class="rule" />
    {
      withMaterials.length > 0 ? (
        <ul class="rows">
          {withMaterials.map((event) => (
            <li class="row">
              <div class="row-when">
                <time class="label" datetime={isoDay(event.data.date)}>{formatDay(event.data.date)}</time>
                <span class="label">{event.data.kind}</span>
              </div>
              <div class="row-body">
                <h3><a href={url(`/events/${event.id}/`)}>{event.data.title}</a></h3>
                <div class="row-links">
                  {event.data.slides && <a href={url(event.data.slides)}>Slides</a>}
                  {event.data.materials.map((item) => <a href={url(item.href)}>{item.label}</a>)}
                </div>
              </div>
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty">Nothing here yet. Slides appear after each event.</p>
      )
    }
  </div>
</Base>
