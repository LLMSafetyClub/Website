---
import '@fontsource-variable/schibsted-grotesk';
import '@fontsource-variable/martian-mono';
import '../styles/global.css';
import { nav, url } from '../site';
import { getClub } from '../content';

interface Props {
  title?: string;
  description?: string;
}

const club = await getClub();
const { title, description = club.description } = Astro.props;
const pageTitle = title ? `${title} | ${club.shortName ?? club.name}` : club.name;
const current = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:title" content={pageTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={url('/')}>
          {club.shortName && <span class="brand-mark">{club.shortName}</span>}
          <span>{club.name}</span>
        </a>
        <nav class="site-nav" aria-label="Main">
          {
            nav.map((item) => (
              <a
                href={url(item.path)}
                aria-current={current.startsWith(url(item.path)) ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <p>
          {club.name}
          {club.school && <Fragment><br />{club.school}</Fragment>}
        </p>
        <ul>
          {club.email && <li><a href={`mailto:${club.email}`}>{club.email}</a></li>}
          {club.channels.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
        </ul>
      </div>
    </footer>
  </body>
</html>
