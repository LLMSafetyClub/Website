---
import type { CollectionEntry } from 'astro:content';
import { url, formatDate, isoDate } from '../site';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
---

<li class="row">
  <div class="row-when">
    <time class="label" datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>
    <span class="label">{post.data.author}</span>
  </div>
  <div class="row-body">
    <h3><a href={url(`/blog/${post.id}/`)}>{post.data.title}</a></h3>
    <p>{post.data.summary}</p>
  </div>
</li>
