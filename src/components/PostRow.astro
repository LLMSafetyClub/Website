---
import { url, formatDay, isoDay } from '../site';
import { titleOf, type Dated } from '../content';

interface Props {
  post: Dated<'posts'>;
}

const { post } = Astro.props;
const { date, author, summary } = post.data;
---

<li class="row">
  <div class="row-when">
    <time class="label" datetime={isoDay(date)}>{formatDay(date)}</time>
    {author && <span class="label">{author}</span>}
  </div>
  <div class="row-body">
    <h3><a href={url(`/blog/${post.id}/`)}>{titleOf(post)}</a></h3>
    {summary && <p>{summary}</p>}
  </div>
</li>
