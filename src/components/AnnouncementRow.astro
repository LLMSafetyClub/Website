---
import { render } from 'astro:content';
import { formatDay, isoDay } from '../site';
import { titleOf, type Dated } from '../content';

interface Props {
  announcement: Dated<'announcements'>;
}

const { announcement } = Astro.props;
const { Content } = await render(announcement);
---

<li class="row" id={announcement.id}>
  <div class="row-when">
    <time class="label" datetime={isoDay(announcement.data.date)}>{formatDay(announcement.data.date)}</time>
  </div>
  <div class="row-body">
    <h3>{titleOf(announcement)}</h3>
    <div class="prose"><Content /></div>
  </div>
</li>

<style>
  .prose {
    margin-top: 0.5rem;
    color: var(--muted);
  }
</style>
